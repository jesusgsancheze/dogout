# Copia este archivo como .env para correr la app en tu computadora.

# Cadena de conexión de MongoDB Atlas (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@tu-cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=dogout

# Administrador inicial. Solo se usa si la base todavía no tiene usuarios.
ADMIN_USERNAME=jesus
ADMIN_PASSWORD=cambia-esta-clave

# Opcionales
# PORT=3000
# SESSION_DAYS=30
